<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- این اپ کاملاً آفلاین است: عمداً هیچ دسترسی اینترنتی وجود ندارد. -->

    <!-- نوتیفیکیشن محلی (اندروید ۱۳+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- یادآور دقیق (اندروید ۱۲+) — برای AlarmManager.setAlarmClock -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- ثبت مجدد یادآورها بعد از ری‌استارت -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".YadyarApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.YadYar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- گیرنده هشدار یادآور -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />

        <!-- گیرنده بوت: ثبت مجدد همه یادآورها -->
        <receiver
            android:name=".reminders.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
